{
  "suite": "operational_listing_parse_event",
  "contract_version": "1.0.0",
  "vectors": [
    {
      "id": "operational_listing_tags_override_json_content_001",
      "kind": "listing.parse_event.valid",
      "input": {
        "event_kind": 30402,
        "content": "{\"product\":{\"title\":\"Content override\",\"category\":\"Content category\"},\"inventory_available\":\"99\"}",
        "tags": [
          ["d", "AAAAAAAAAAAAAAAAAAAAAg"],
          ["p", "farm_pubkey"],
          ["a", "30340:farm_pubkey:AAAAAAAAAAAAAAAAAAAAAA"],
          ["key", "sku"],
          ["title", "Widget"],
          ["category", "Tools"],
          ["radroots:primary_bin", "bin-1"],
          ["radroots:bin", "bin-1", "1", "each"],
          ["radroots:price", "bin-1", "10", "USD", "1", "each"],
          ["price", "10", "USD"]
        ]
      },
      "expected": {
        "listing": {
          "d_tag": "AAAAAAAAAAAAAAAAAAAAAg",
          "title": "Widget",
          "category": "Tools",
          "primary_bin_id": "bin-1",
          "quantity_amount": "1",
          "quantity_unit": "each",
          "price_amount": "10",
          "price_currency": "USD",
          "inventory_available": null
        }
      }
    },
    {
      "id": "operational_listing_missing_d_001",
      "kind": "listing.parse_event.invalid",
      "input": {
        "event_kind": 30402,
        "content": "# Widget",
