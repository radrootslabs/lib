{
  "schema_version": 1,
  "contract_id": "radroots.secrets.browser_provider.v1",
  "state": "implemented_browser_host_component",
  "owner": "radroots_secrets",
  "feature": "browser",
  "target": "wasm32-unknown-unknown",
  "radroots_dependencies_allowed": false,
  "residency": "user_profile_origin_storage",
  "device_local_claim": false,
  "user_presence_claim": false,
  "hardware_backed_claim": false,
  "participant_signer_authority": false,
  "stock_authority": false,
  "provider_backend": "external",
  "master": {
    "material_bytes": 32,
    "entropy": "browser_crypto_get_random_values",
    "algorithm": "HKDF",
    "extractable": false,
    "usages": ["deriveKey"],
    "persistence": "indexeddb_structured_clone",
    "raw_export_allowed": false
  },
  "wrapping": {
    "version": 1,
    "magic_ascii": "RRBW",
    "data_key_bytes": 32,
    "wrapped_key_bytes": 40,
    "encoded_bytes": 45,
    "derivation": "HKDF-SHA-256",
    "key_algorithm": "AES-KW",
    "key_bits": 256,
    "binding": ["namespace", "secret_id", "key_version", "expected_envelope_context_digest"],
    "probe_domain_separate": true,
    "generic_envelope_v2_unchanged": true,
    "legacy_unwrap_default_denied": true
  },
  "storage": {
    "namespace_prefix": "radroots.secrets.browser.v1.",
    "version": 1,
    "store": "provider",
    "records": ["binding", "key"],
    "one_immutable_key_per_namespace": true,
    "create_and_open_separate": true,
    "creation_key_and_binding_atomic": true,
    "acknowledgement": "actual_upgrade_transaction_completion",
    "existing_open_requires_expected_fingerprint": true,
    "missing_key_replacement_allowed": false,
    "implicit_creation_allowed": false,
    "implicit_migration_allowed": false,
    "old_namespaces_retained": true
  },
  "resources": {
    "jobs_max": 32,
    "setup_jobs_max_per_host_thread": 32,
    "setup_create_and_open_share_admission": true,
    "retained_bytes_max": 4194304,
    "close_waiters_max": 32,
    "accepted_work_rust_owned": true,
    "callbacks_retained_until_terminal_event": true,
    "close_drains_accepted_work": true
  },
  "qualification": {
    "contexts": ["main_thread", "dedicated_worker"],
    "browsers": ["chromium", "firefox", "webkit"],
    "page_and_worker_restart_required": true,
    "public_fingerprint_is_not_authority": true,
    "authenticated_journal_or_full_client_claim": false
  }
}
